NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/myFitness
JWT_SECRET=dummy_jwt_secret_change_me_min_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Cloudinary (set CLOUDINARY_MOCK=false and real values later)
CLOUDINARY_MOCK=true
CLOUDINARY_CLOUD_NAME=dummy_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=dummy_api_secret
CLOUDINARY_UPLOAD_FOLDER=myfitness/avatars

# LLM / RAG (set RAG_MOCK=false and real values later; verify current model names in the provider docs)
RAG_MOCK=true
LLM_PROVIDER=gemini
LLM_API_KEY=dummy_llm_api_key
LLM_MODEL=set_me_later
EMBEDDING_MODEL=set_me_later
# Optional. Gemini gemini-embedding-001 supports 768, 1536 or 3072.
# Leave blank for fixed-size embedding models such as text-embedding-004 (768).
EMBEDDING_DIMENSIONS=
RAG_TOP_K=6
# Keep model calls below the Vercel function max duration (90s default)
LLM_TIMEOUT_MS=115000

# Rate limits (MongoDB-backed for auth/assistant; global is per-instance best effort)
APP_TIMEZONE=Asia/Kolkata
ASSISTANT_DAILY_LIMIT=5
LOGIN_PAIR_LIMIT=5
LOGIN_IP_LIMIT=20
LOGIN_WINDOW_MINUTES=15
SIGNUP_IP_LIMIT=5
SIGNUP_WINDOW_MINUTES=60
GLOBAL_IP_LIMIT=300
GLOBAL_WINDOW_MINUTES=15

# Only set true if you intentionally accept mock providers in production
ALLOW_MOCK_IN_PROD=false

# Render is behind a proxy layer; client -> Vercel -> Render proxy -> app
TRUST_PROXY_HOPS=2
# Enable temporarily to verify req.ip, then turn off
ENABLE_IP_DEBUG=false
